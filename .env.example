# Set the production URL only after school approval and domain configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_LAUNCH=false
NEXT_PUBLIC_SITE_TIME_ZONE=Africa/Harare
# Defaults to the official OSM raster endpoint. Replace with a licensed OSM-derived
# provider if traffic exceeds the OpenStreetMap Foundation's standard-tile policy.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CMS_PERF_LOG=false
CMS_DASHBOARD_RPC=false

# Set the production URL only after school approval and domain configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_LAUNCH=false
NEXT_PUBLIC_SITE_TIME_ZONE=Africa/Harare
# Defaults to the official OSM raster endpoint. Replace with a licensed OSM-derived
# provider if traffic exceeds the OpenStreetMap Foundation's standard-tile policy.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CMS_PERF_LOG=false
CMS_DASHBOARD_RPC=false

# Optional GA4. Leave empty until school privacy review and consent testing.
NEXT_PUBLIC_GA_ID=

# Rate limiting: production requires an HTTPS Redis REST endpoint (EVAL support).
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_KEY_SECRET=
# Set ONLY when your ingress overwrites this header and direct origin access is blocked.
RATE_LIMIT_IP_HEADER=
RATE_LIMIT_PROXY_HOPS=1
# Login: three failed credentials, then a full five-minute wait.
RATE_LIMIT_LOGIN_MAX=3
RATE_LIMIT_LOGIN_SECONDS=300
# Separate request allowance across API, writes, uploads and news queries.
RATE_LIMIT_ATTEMPTS_MAX=3
RATE_LIMIT_ATTEMPTS_SECONDS=300
